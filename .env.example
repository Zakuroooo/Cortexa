# ── REQUIRED ─ Supabase (free): create project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── RECOMMENDED ─ LLM provider: groq | gemini | openai | custom   (Groq = fast + free tier)
# Free Groq key: https://console.groq.com/keys   ·   Free Gemini key: https://aistudio.google.com/apikey
#
# ★ MULTI-KEY FAILOVER: separate keys with commas. If one hits a rate limit (429),
#   the app automatically switches to the next healthy key — zero downtime.
LLM_PROVIDER=groq
LLM_API_KEY=gsk_key1,gsk_key2,gsk_key3

# Aliases also accepted (merged together): GROQ_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY
# Optional overrides:
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL= (only for LLM_PROVIDER=custom, e.g. http://localhost:11434/v1 for Ollama)

# ── EMBEDDINGS ─ quality of retrieval + memory recall depends entirely on this.
#   jina   ★ recommended — free 10M tokens, no card, native 768-dim.  https://jina.ai/embeddings
#   ollama   free forever & offline: `ollama pull nomic-embed-text` (768-dim native)
#   gemini   free, but many new Google projects are blocked (403 PERMISSION_DENIED)
#   local    zero-key hashed fallback — works, but matches keywords more than meaning
# Leave EMBEDDING_PROVIDER unset to auto-pick whichever key you have.
EMBEDDING_PROVIDER=jina
JINA_API_KEY=jina_key1,jina_key2
# GEMINI_API_KEY=            # used when EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=           # override the per-provider default
# OLLAMA_BASE_URL=http://localhost:11434

# ── OPTIONAL ─ Web search tool for the Agent (free tier): https://tavily.com
# Comma-separate multiple Tavily keys too; falls back to DuckDuckGo if all fail.
TAVILY_API_KEY=tvly-key1,tvly-key2

# ── LIVE DATA ─ nothing to configure.
# Weather + local time (open-meteo.com), FX rates (frankfurter.app) and crypto
# prices (coingecko.com) are all keyless on their free tiers and work out of the box.

# ── OPTIONAL ─ MCP server (mcp/server.mjs) — exposes this knowledge base,
# its memory and the live-data tools to Claude Desktop or any MCP client.
# Only needed if you run the MCP server; the web app never uses these.
# Service role key: Supabase → Settings → API → service_role (KEEP SECRET).
# User id: Supabase → Authentication → Users → your row → UID.
# SUPABASE_SERVICE_ROLE_KEY=
# CORTEXA_USER_ID=
